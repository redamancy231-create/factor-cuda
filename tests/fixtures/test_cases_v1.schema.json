{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factor-cuda.local/schemas/test_cases_v1.schema.json",
  "title": "factor-cuda executable test manifest",
  "description": "Versioned wildcard templates plus committed deterministic expansion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_version",
    "execution_date",
    "schema_path",
    "schema_sha256",
    "generator_path",
    "generator_sha256",
    "fixture_sha256_kind",
    "fixture_sha256",
    "recoverable_launch_errors",
    "fatal_faults",
    "wildcard_templates",
    "expanded_case_count",
    "target_count",
    "expanded_cases"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_version": {"const": "1.1.0"},
    "execution_date": {"const": "2026-08-04"},
    "schema_path": {"$ref": "#/$defs/repoPath"},
    "schema_sha256": {"$ref": "#/$defs/sha256"},
    "generator_path": {"$ref": "#/$defs/repoPath"},
    "generator_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_sha256_kind": {"const": "sha256(canonical-json-without-fixture_sha256)"},
    "fixture_sha256": {"$ref": "#/$defs/sha256"},
    "recoverable_launch_errors": {
      "type": "array",
      "prefixItems": [
        {"const": "cudaErrorInvalidConfiguration"},
        {"const": "cudaErrorLaunchOutOfResources"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "fatal_faults": {
      "type": "array",
      "minItems": 12,
      "items": {"$ref": "#/$defs/fatalFault"}
    },
    "wildcard_templates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/template"}
    },
    "expanded_case_count": {"type": "integer", "minimum": 1},
    "target_count": {"type": "integer", "minimum": 1},
    "expanded_cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\).+$"
    },
    "structured": {"type": "object"},
    "fatalFault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "stage", "error"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "class": {"const": "fatal"},
        "stage": {"type": "string", "minLength": 1},
        "error": {"type": "string", "minLength": 1}
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id", "case_id_pattern", "target", "axes", "input", "injection", "expect"],
      "properties": {
        "template_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "case_id_pattern": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/repoPath"},
        "axes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "array", "minItems": 1}
        },
        "input": {"$ref": "#/$defs/structured"},
        "injection": {"$ref": "#/$defs/structured"},
        "expect": {"$ref": "#/$defs/structured"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "template_id", "target", "axes", "input", "injection", "expect"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
        "template_id": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/repoPath"},
        "axes": {"$ref": "#/$defs/structured"},
        "input": {"$ref": "#/$defs/structured"},
        "injection": {"$ref": "#/$defs/structured"},
        "expect": {"$ref": "#/$defs/structured"}
      }
    }
  }
}